# ==============================================================================
# Joy University Smart Campus ERP - Backend Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env: `cp .env.example .env`
# 2. Populate with environment-specific values.
# 3. DO NOT commit .env or real credentials to version control.
# ==============================================================================

# Server Network & Runtime Environment
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. production domain, local dev)
CLIENT_URL=http://localhost:5173

# MySQL Primary Relational Database Configuration (Authoritative Store)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smart_campus_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=smart_campus

# MongoDB Secondary Database Configuration (Attendance Raw Audit Logs)
# Required only when attendance audit log archiving is enabled
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_attendance_logs

# JWT Authentication & Server-Side Revocation
# Use a high-entropy cryptographically random string (e.g. openssl rand -hex 64)
JWT_SECRET=your_secure_random_64_character_hex_secret_here
JWT_EXPIRES_IN=1d

# Optional Development / QA Demo Credentials Template
# NOTE: Active only when database is seeded with demo fixtures (`npm run db:seed:demo`)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123

DEMO_FACULTY_USERNAME=FAC001
DEMO_FACULTY_PASSWORD=Faculty@123

DEMO_STUDENT_USERNAME=J26AIM001
DEMO_STUDENT_PASSWORD=Student@123
