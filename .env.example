# ==============================================================================
# Joy University Smart Campus ERP - Backend Environment Configuration Template
# Duplicate this file to .env and configure secrets accordingly.
# ==============================================================================

# Server Network & Base Endpoint
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:5173

# MySQL Relational Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_USER="db_user"
DB_PASSWORD="db_password"
DB_NAME="smart_campus"

# MongoDB Connection URI (Attendance Audit Trail)
MONGO_URI=mongodb://localhost:27017/attendance_logs

# JWT Authentication
JWT_SECRET="your_secure_random_64_character_hex_secret_here"
JWT_EXPIRES_IN=1d

# Pre-seeded Anonymous / Demo Credentials (for testing and verification)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=Admin@123

DEMO_FACULTY_USERNAME=FAC001
DEMO_FACULTY_PASSWORD=Faculty@123

DEMO_STUDENT_USERNAME=J26AIM001
DEMO_STUDENT_PASSWORD=Student@123